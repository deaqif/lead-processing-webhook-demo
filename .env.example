# ==============================================================================
# Environment Configuration (Example)
# Copy this file to .env and replace placeholders with your actual settings
# If placeholders or mock values are left as-is, Mock Mode is automatically used.
# ==============================================================================

# Application Environment (demo | development | production)
APP_ENV=demo
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# Webhook Security (Optional shared secret token for header validation)
# Header: X-Webhook-Secret
WEBHOOK_SECRET_KEY=demo_secret_token_12345

# Database Configuration
DATABASE_URL=sqlite:///./leads.db

# Telegram Bot Integration
# When set to placeholder values, TelegramService runs in Mock Mode (logs formatted message)
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_THREAD_ID=

# Google Sheets Integration
# Optional: Path to Google Service Account JSON key file and target Spreadsheet ID
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_RANGE=Leads!A:H

# Email Notification Service (SMTP)
# When SMTP_HOST is empty, EmailService runs in Mock Mode
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@yourdomain.com
NOTIFICATION_RECIPIENT_EMAIL=sales-team@yourdomain.com
